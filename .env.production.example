# Configure these in the deployment environment. Do not commit actual credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
REDIS_URL=redis://:PASSWORD@HOST:6379
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace-with-a-random-production-secret

# Stripe live mode
STRIPE_SECRET_KEY=sk_live_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_secret
NEXT_PUBLIC_STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_replace_with_monthly_live_id
NEXT_PUBLIC_STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=price_replace_with_annual_live_id

# Mailing
MILLIONSEND_API_KEY=ms_
MILLIONSEND_FROM=Syncar <no-reply@your-verified-domain.example>

CRON_SECRET=replace-with-another-random-production-secret
