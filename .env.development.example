# Copy to .env.development.local and replace values for your machine.
DATABASE_URL=postgresql://syncar:syncar-local@127.0.0.1:5433/syncar?schema=public
REDIS_URL=redis://:syncar-redis-local@127.0.0.1:6379
CACHE_METRICS_ENABLED=false
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_secret
NEXT_PUBLIC_STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_1SHloiP7QrM0bVUXJWA8ndzX
NEXT_PUBLIC_STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=price_1SHlpGP7QrM0bVUXJxP8B5L3

# Mailing
MILLIONSEND_API_KEY=ms_
MILLIONSEND_FROM=Syncar <no-reply@your-verified-domain.example>

CRON_SECRET=replace-with-another-random-secret
