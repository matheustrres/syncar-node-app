generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  CONTRACT_ENDING
  PAYMENT_OVERDUE
  MAINTENANCE_REMINDER
}

model User {
  id               String               @id @default(cuid())
  name             String
  email            String               @unique
  password         String
  companyName      String               @map("company_name")
  phone            String
  plan             String               @default("BASIC")
  stripeCustomerId String?              @unique @map("stripe_customer_id")
  vehicles         Vehicle[]
  drivers          Driver[]
  contracts        Contract[]
  expenses         Expense[]
  resetTokens      PasswordResetToken[]
  notifications    Notification[]
  maintenances     Maintenance[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Notification {
  id              String           @id @default(cuid())
  type            NotificationType
  message         String
  relatedEntityId String           @map("related_entity_id")
  isRead          Boolean          @default(false) @map("is_read")
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}

model Vehicle {
  id              String        @id @default(cuid())
  plate           String        @unique
  plateNormalized String?       @map("plate_normalized")
  brand           String
  model           String
  modelNormalized String?       @map("model_normalized")
  year            Int
  color           String
  renavam         String        @unique
  chassis         String        @unique
  km              Int
  status          String        @default("Disponível")
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts       Contract[]
  expenses        Expense[]
  maintenances    Maintenance[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("vehicles")
}

model Driver {
  id             String     @id @default(cuid())
  name           String
  nameNormalized String?    @map("name_normalized")
  cpf            String     @unique
  phone          String
  email          String
  cnh            String     @unique
  cnhValidity    DateTime   @map("cnh_validity")
  cep            String?
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  uf             String?
  status         String     @default("Ativo")
  userId         String     @map("user_id")
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts      Contract[]
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("drivers")
}

model Contract {
  id          String    @id @default(cuid())
  weeklyValue Float     @map("weekly_value")
  paymentDay  String    @map("payment_day")
  startDate   DateTime  @map("start_date")
  deposit     Float
  status      String    @default("Ativo")
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId   String    @map("vehicle_id")
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId    String    @map("driver_id")
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  duration    Int?
  payments    Payment[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("contracts")
}

model Payment {
  id          String    @id @default(cuid())
  weekStart   DateTime  @map("week_start")
  weekEnd     DateTime  @map("week_end")
  value       Float
  dueDate     DateTime  @map("due_date")
  paymentDate DateTime? @map("payment_date")
  status      String    @default("Pendente")
  contractId  String    @map("contract_id")
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("payments")
}

model Expense {
  id          String   @id @default(cuid())
  type        String
  description String
  value       Float
  date        DateTime
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId   String   @map("vehicle_id")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("expenses")
}

enum MaintenanceType {
  PREVENTIVA
  CORRETIVA
  TROCA_OLEO
  PNEUS
  FREIOS
  OUTROS
}

model Maintenance {
  id                 String          @id @default(cuid())
  vehicleId          String          @map("vehicle_id")
  vehicle            Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type               MaintenanceType
  description        String
  cost               Float
  date               DateTime
  mileage            Int
  nextServiceMileage Int?            @map("next_service_mileage")
  nextServiceDate    DateTime?       @map("next_service_date")
  notes              String?
  userId             String          @map("user_id")
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("maintenances")
}
